# Resend API Configuration for Sentinel-X Website Backend
RESEND_API_KEY=re_123456789_your_real_resend_api_key
RESEND_FROM_EMAIL=Sentinel-X <onboarding@resend.dev>

# Neon PostgreSQL Database Connection
DB_HOST=ep-xyz-123456.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_SSLMODE=require

# Connection Pool (Optional)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# JWT Secret Key (min 32 chars)
JWT_SECRET=sentinelx_default_jwt_secret_key_minimum_32_bytes_long_123456
